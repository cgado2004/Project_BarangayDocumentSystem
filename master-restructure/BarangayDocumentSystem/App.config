<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    The protocol keeps the database location here, out of the code.
    DatabaseSettings (DBContext/DatabaseSettings.cs) reads the
    BarangayDb connection string from this file; the environment
    variable BARANGAY_DB, if set, overrides it so a real password can
    stay out of source control.
  -->

  <connectionStrings>
    <add name="BarangayDb"
         connectionString="Server=localhost;Port=3306;Database=barangay_db;User ID=root;Password=;CharSet=utf8mb4;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

</configuration>
