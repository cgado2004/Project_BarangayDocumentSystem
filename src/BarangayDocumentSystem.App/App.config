<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    I put every value that might change into this file instead of burying it
    inside my code.

    My reason is simple: if I type a value into a .cs file, I have to rebuild
    the whole program just to change it. Here I can edit the value, save, and
    restart. It also means my group-mates can point the app at their own MySQL
    server without touching a single line of C#.

    Visual Studio 2022 copies this file into the output folder as
    BarangayDocumentSystem.App.dll.config when I build, which is how the
    running program finds it.
  -->

  <appSettings>

    <!-- Which storage I want the app to use.

         "Memory" is the sample data - it needs no database at all, so it
         always works on a fresh machine and it is what I use for a demo.
         "MySQL" switches to the real database using the connection string
         below.

         This one setting is the only thing I change to move the whole system
         onto a real database. -->
    <add key="Storage" value="Memory" />

    <!-- These appear on every document I print. I keep them here because the
         officials change after an election, and I would rather my group-mates
         edit this file than go hunting through the source. -->
    <add key="Barangay.Name" value="Barangay Magugpo Poblacion" />
    <add key="Barangay.City" value="City of Tagum" />
    <add key="Barangay.Province" value="Davao del Norte" />
    <add key="Barangay.PunongBarangay" value="HON. EUGENIA SOLIS HINGPIT, MD" />
    <add key="Barangay.OfficeHours" value="Monday to Friday, 8:00 AM - 5:00 PM" />

    <!-- The fees, in pesos.

         I took every one of these from the Barangay Citizen's Charter posted
         at the hall, so they are the real posted rates and not figures I made
         up. A barangay may only collect what its revenue ordinance allows, so
         if the ordinance changes these are the numbers to edit - and this is
         the only place I have written them down. -->
    <add key="Fee.Clearance.Local" value="100" />
    <add key="Fee.Clearance.Abroad" value="200" />
    <add key="Fee.Certification" value="100" />
    <add key="Fee.BusinessClearance" value="200" />
    <add key="Fee.LuponFiling" value="150" />

    <!-- RA 11261 requires at least six months of residency before a first
         time jobseeker certificate can be issued. I made it a setting rather
         than a constant so that if the law or its guidelines ever change, I
         am not editing code to follow them. -->
    <add key="Rule.JobseekerResidencyMonths" value="6" />

  </appSettings>

  <connectionStrings>

    <!--
      My MySQL connection.

      I left this as the XAMPP default - user "root" with an EMPTY password -
      because that is what my group-mates will have on their own machines and
      it means the app works for them with no setup.

      I want to be honest that this is fine for our class demo and NOT fine
      anywhere real. On an actual barangay computer this needs its own user,
      with a real password, granted rights to this one database only.

      SslMode=Preferred means "encrypt if the server supports it" rather than
      "fail if it does not", which is what XAMPP needs.
      CharSet=utf8mb4 is there so names like Peña store correctly.
    -->
    <add name="BarangayDb"
         connectionString="Server=localhost;Port=3306;Database=barangay_magugpo;Uid=root;Pwd=;SslMode=Preferred;CharSet=utf8mb4;"
         providerName="MySql.Data.MySqlClient" />

  </connectionStrings>

</configuration>
