# I added this so every editor formats my code the same way. Visual Studio,
# VS Code and Rider all read this file, so a teammate on a different machine
# cannot accidentally reformat my files with different settings.
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Project and MSBuild files conventionally use 2 spaces, not 4.
[*.{csproj,props,targets,config,xml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces mean "line break" in Markdown, so I must not strip them.
trim_trailing_whitespace = false

[*.cs]
# ---- using directives ----
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ---- language style I actually use in this codebase ----
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = when_multiline:suggestion

# ---- naming ----
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# ---- things I want flagged ----
dotnet_diagnostic.CA2000.severity = suggestion   # dispose objects before losing scope
dotnet_diagnostic.CS1591.severity = none         # don't demand XML docs on everything
