<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{9077BDF9-C14F-4BC1-A068-2BF52A9FA8CB}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BarangayDocumentSystem</RootNamespace>
    <AssemblyName>BarangayDocumentSystem</AssemblyName>
    <!-- The revamped system still targets .NET Framework, as the barangay
         asked: 4.8 (it also runs on 4.7.2 - nothing here needs anything
         newer). LangVersion 10 is the C# version that ships with Visual
         Studio 2022, which is the version the barangay hall has. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>10.0</LangVersion>
    <Deterministic>true</Deterministic>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackages>true</RestorePackages>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols><DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize><DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <!-- System.Configuration is what lets AppConfig read App.config. -->
    <Reference Include="System.Configuration" />
    <!-- System.Security carries the Windows data-protection class used when
         the connection string is sealed instead of written in plain text. -->
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MySQL driver. Visual Studio restores it (and its own
         dependencies) the first time the project builds, so nothing has to
         be installed by hand before opening the solution. -->
    <PackageReference Include="MySql.Data" Version="8.4.0" />
  </ItemGroup>
