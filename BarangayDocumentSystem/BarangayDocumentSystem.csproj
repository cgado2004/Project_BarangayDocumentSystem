  <ItemGroup>
    <!-- The database scripts travel inside the program as embedded
         resources. There is one copy of each, the program always installs
         the schema that matches its own code, and nobody can lose a .sql
         file from a USB stick. -->
    <EmbeddedResource Include="Database\Scripts\MySql\01-schema.sql" />
    <EmbeddedResource Include="Database\Scripts\MySql\02-procedures.sql" />
    <EmbeddedResource Include="Database\Scripts\SqlServer\01-schema.sql" />
    <EmbeddedResource Include="Database\Scripts\SqlServer\02-procedures.sql" />
  </ItemGroup>
  <ItemGroup>
    <!-- The seal. It is copied next to the .exe so the documents and the
         login card can draw it. This file is NOT edited - only drawn. -->
    <None Include="Assets\barangay-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Crystal Reports layouts, when the barangay has Crystal installed.
         They are read at run time, never compiled in. -->
    <None Include="Reports\CrystalReports\**.rpt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
