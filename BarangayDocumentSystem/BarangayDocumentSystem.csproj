<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BarangayDocumentSystem</RootNamespace>
    <AssemblyName>BarangayDocumentSystem</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- ============================================================
         HIGH-DPI, FIX 2 OF THE v3.1 CORE TECHNICAL FIXES

         ApplicationConfiguration.Initialize() in Program.cs reads this
         property and calls Application.SetHighDpiMode(PerMonitorV2) for
         me, which is the supported way to switch DPI modes on .NET 8.
         app.manifest carries the same setting as well, so the mode holds
         even for the parts of the runtime that read the manifest, and
         App.config records it for documentation. Belt, braces and a note.
         ============================================================ -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- app.manifest carries the PerMonitorV2 dpiAwareness block and the
         supportedOS list. Visual Studio picks it up from here. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- ============================================================
         BUILDING ON LINUX / macOS

         A net8.0-windows project normally refuses to build off Windows.
         EnableWindowsTargeting lets the Windows targeting packs be
         downloaded and the project compiled from a Linux box (the way the
         v3 code was verified before this ever ran on Windows). On Windows
         the condition is false and nothing changes.
         ============================================================ -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- I make sure App.config travels with the build output so the running
         program can actually find it, whatever MSBuild decides to call it.
         AppSettings probes the usual candidate names at startup. -->
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- The barangay seal has to be beside the .exe at run time, or the
         dashboard banner and the sidebar come up without it. -->
    <None Update="Assets\barangay-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    NOTE ON NUGET AND THE DESIGNER, v3.1 FIX 1.

    This project deliberately references no NuGet packages, so the whole
    solution restores and builds with no network at all. App.config is read
    through System.Xml.Linq in Program.cs instead of the
    System.Configuration.ConfigurationManager package.

    packages.config is still present because the Visual Studio WinForms
    designer surface for custom controls looks for the accessibility
    assemblies it lists. It is inert at compile time - the build never
    consults it - but its presence keeps the designer from complaining on a
    machine where those reference assemblies are registered the old way.
  -->

</Project>
