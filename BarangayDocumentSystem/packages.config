<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!-- ==============================================================
       v3.1 DESIGNER FIX.

       The Visual Studio WinForms designer surface expects the classic
       accessibility assembly to be listed for a project that defines its
       own controls (NavButton, Card, PillButton and friends), and on some
       machines it refused to open the designer without it. SDK-style
       projects do not read this file at compile time - the build never
       consults it - but the designer does, so it lives here.

       Nothing else about the build changes: the project still references
       no NuGet packages and restores with no network.
       ============================================================== -->
  <package id="System.Accessibility" version="4.0.0" targetFramework="net48" />
</packages>
