<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Standard .NET Framework configuration file. It is compiled into
    "BarangayDocumentSystem.exe.config" next to the .exe, and can be edited
    there after installing the app -- no rebuild required.
  -->
  <configSections>
    <!-- Lets a WinForms app declare its DPI behaviour here instead of only
         through the application manifest (added in .NET Framework 4.7). -->
    <section name="System.Windows.Forms.ApplicationConfigurationSection"
             type="System.Windows.Forms.ApplicationConfigurationSection, System.Windows.Forms" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <gcServer enabled="true" />
    <!-- AutoGenerateBindingRedirects (in the .csproj) writes the actual
         <dependentAssembly> entries for MySql.Data's dependencies into this
         section at build time. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>

  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>

  <!--
    Where the app connects. The default below matches a stock local
    MySQL / XAMPP install (user root, blank password) -- see
    DatabaseSettings.cs. Change it to match your server, or set the
    BARANGAY_DB_CONNECTION environment variable instead, which always wins
    over this file.
  -->
  <connectionStrings>
    <add name="BarangayDb"
         connectionString="Server=localhost;Port=3306;Database=barangay_db;User ID=root;Password=;CharSet=utf8mb4;" />
  </connectionStrings>

  <appSettings>
    <!-- true: load the 7 demo residents into an EMPTY database on first run.
         Set to false once you are using this for real data. -->
    <add key="SeedSampleData" value="true" />
  </appSettings>
</configuration>
