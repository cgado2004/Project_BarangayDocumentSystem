<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!--
    Standard .NET Framework configuration file. It is compiled into
    "BarangayDocumentSystem.exe.config" next to the .exe
  -->
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<runtime>
		<gcServer enabled="true" />
		<!-- AutoGenerateBindingRedirects (in the .csproj) writes the actual
         <dependentAssembly> entries for MySql.Data's dependencies into this
         section at build time. -->
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
	</runtime>

	<System.Windows.Forms.ApplicationConfigurationSection>
		<add key="DpiAwareness" value="PerMonitorV2" />
	</System.Windows.Forms.ApplicationConfigurationSection>
	<!--
   Server Connection details
  -->
	<connectionStrings>
		<add name="BarangayDb"
			 connectionString="Server=localhost;Port=3306;Database=barangay_db;User ID=root;Password=Blazer143!;CharSet=utf8mb4;" />
	</connectionStrings>

	<appSettings>
		<!-- Seed data activation(True for demo, false for actual field use) -->
		<add key="SeedSampleData" value="true" />
	</appSettings>
</configuration>
