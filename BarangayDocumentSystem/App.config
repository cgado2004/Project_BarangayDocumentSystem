<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Every value that might change lives here instead of inside the code,
    so nobody has to rebuild to adjust a fee, a name or a rule.

    v3.1 reads this file with System.Xml.Linq through AppSettings (in
    Program.cs). I deliberately use no configuration package, which keeps
    the whole solution building with no NuGet restore and no network.
  -->

  <appSettings>

    <!-- Which storage the app uses.

         "Memory" is the sample data - no database, always works on a fresh
         machine, the one to use for a demo. "MySQL" switches to the real
         database using the connection string below (the repository class
         itself is still to come; until then the app says so plainly and
         falls back to the sample data rather than pretending). -->
    <add key="Storage" value="Memory" />

    <!-- These appear on every document printed. The officials change after
         an election; this file is where my group-mates edit them. -->
    <add key="Barangay.Name" value="Barangay Magugpo Poblacion" />
    <add key="Barangay.City" value="City of Tagum" />
    <add key="Barangay.Province" value="Davao del Norte" />
    <add key="Barangay.PunongBarangay" value="HON. EUGENIA SOLIS HINGPIT, MD" />
    <add key="Barangay.OfficeHours" value="Monday to Friday, 8:00 AM - 5:00 PM" />

    <!-- ==========================================================
         THE CITIZEN'S CHARTER FEE SCHEDULE, in pesos.

         Barangay Clearance ........... 100 local employment
                                      200 for work abroad
         Certification ................ 100  (residency, good moral, other)
         Certificate of Indigency ..... FREE
         Certificate of Low Income .... FREE
         Business Clearance ........... VARIES with the law violated;
                                      200 is the standard rate below
         Cedula (community tax) ....... VARIES - computed per RA 7160
                                      Sec. 156 from declared income
         Filing a case (Katarungang
         Pambarangay) ................. 150
         Barangay facilities .......... 200 per hour

         A barangay may only collect what its revenue ordinance allows, so
         when the ordinance changes these are the numbers to edit - and
         this is the only place they are written down.
         ========================================================== -->
    <add key="Fee.Clearance.Local" value="100" />
    <add key="Fee.Clearance.Abroad" value="200" />
    <add key="Fee.Certification" value="100" />
    <add key="Fee.BusinessClearance.Standard" value="200" />
    <add key="Fee.LuponFiling" value="150" />
    <add key="Fee.Facility.Hourly" value="200" />

    <!-- The community tax formula for individuals under RA 7160 Sec. 156:
         a basic tax plus one peso for every thousand pesos of gross annual
         income from the preceding year, the additional portion capped. -->
    <add key="Fee.CommunityTax.Base" value="5" />
    <add key="Fee.CommunityTax.PerThousand" value="1" />
    <add key="Fee.CommunityTax.Cap" value="5000" />

    <!-- RA 11261 requires at least six months of residency in the issuing
         barangay before a first-time jobseeker certificate may be issued,
         and the benefit may be availed once only. -->
    <add key="Rule.JobseekerResidencyMonths" value="6" />

    <!-- RA 11032 (Ease of Doing Business) prescribes 3 working days for a
         simple frontline transaction. The request queue highlights any
         request older than this. -->
    <add key="Rule.RA11032.SimpleWorkingDays" value="3" />

  </appSettings>

  <connectionStrings>

    <!--
      My MySQL connection, for the day the MySQL repository lands.

      XAMPP default - user root, empty password - so it works on my
      group-mates' machines with no setup. Fine for a class demo, NOT fine
      anywhere real: a production machine needs its own user, with a real
      password, granted rights to this one database only.

      CharSet=utf8mb4 is there so names like Peña store correctly.
    -->
    <add name="BarangayDb"
         connectionString="Server=localhost;Port=3306;Database=barangay_magugpo;Uid=root;Pwd=;SslMode=Preferred;CharSet=utf8mb4;"
         providerName="MySql.Data.MySqlClient" />

  </connectionStrings>

  <!-- ==============================================================
       HIGH-DPI, v3.1 CORE FIX 2.

       On .NET Framework this section is what switched WinForms into
       PerMonitorV2 mode. On .NET 8 the operative settings are the
       <ApplicationHighDpiMode> property in the .csproj (which
       ApplicationConfiguration.Initialize() turns into a
       Application.SetHighDpiMode call) and the <dpiAwareness> block in
       app.manifest. I keep the section here as well so the intent is
       written down in the one file a maintainer is most likely to open,
       and so a machine still loading the config the old way agrees with
       the other two.
       ============================================================== -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>

</configuration>
