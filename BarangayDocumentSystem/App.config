<?xml version="1.0" encoding="utf-8"?>
<!--
  =========================================================================
   App.config - the whole of the barangay's settings, in one plain file.

   This is the answer to "it must be .config-friendly": every number the
   barangay may want to change - the fees, the office hours, the two
   residency tests, the sign-in rules, the report folder - lives here with a
   sentence explaining it. Nobody has to open the program in Visual Studio
   to change a fee.

   Once the program is built, this file is copied next to it as
   BarangayDocumentSystem.exe.config, and THAT is the copy to edit on the
   office computer.

   Two notes I want written down rather than remembered:
     * Storage picks the provider: MySQL (the default), SqlServer, or Memory
       for a machine with no database at all - useful for a demonstration.
     * The connection strings below suit a normal XAMPP or SQL Server
       install on the same computer. If the password should not sit in this
       file, either set Security.ProtectConnectionString to true, or set the
       environment variable BARANGAY_DB_CONNECTION and leave this file alone.
  =========================================================================
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!-- ==================================================================
         What kind of storage to use
         ================================================================== -->
    <add key="Storage" value="MySQL" />
    <!-- Add a handful of sample residents and requests to an empty
         database, so the first screen a clerk sees is never blank. Set
         this to false once the barangay starts encoding its own records. -->
    <add key="SeedSampleData" value="true" />
    <add key="LogFolder" value="logs" />

    <!-- ==================================================================
         The barangay itself - these appear on every printed document
         ================================================================== -->
    <add key="Barangay.Name" value="Barangay Magugpo Poblacion" />
    <add key="Barangay.City" value="City of Tagum" />
    <add key="Barangay.Province" value="Davao del Norte" />
    <add key="Barangay.PunongBarangay" value="HON. EUGENIA SOLIS HINGPIT, MD" />
    <add key="Barangay.OfficeHours" value="Monday to Friday, 8:00 AM - 5:00 PM" />
    <!-- The seal. This is the file that has always been in the project and
         it is not to be edited or replaced - the program only draws it. -->
    <add key="Barangay.Logo" value="Assets\barangay-logo.png" />

    <!-- ==================================================================
         Fees - the Citizen's Charter rates of this barangay
         ================================================================== -->
    <add key="Fee.Clearance.Local" value="100" />
    <add key="Fee.Clearance.Abroad" value="200" />
    <add key="Fee.Certification" value="100" />
    <add key="Fee.BusinessClearance.Standard" value="200" />
    <add key="Fee.LuponFiling" value="150" />
    <add key="Fee.Facility.Hourly" value="200" />

    <!-- Student is a FEE CATEGORY in this system, not a classification:
         a student ticket here discounts the documents listed below and
         nothing else. Leave Enabled as false to charge students the same
         as everybody else. -->
    <add key="Fee.Student.Enabled" value="true" />
    <add key="Fee.Student.DiscountPercent" value="50" />
    <add key="Fee.Student.Documents"
         value="BarangayClearance,CertificateOfResidency,CertificateOfGoodMoralCharacter,EmploymentCertification" />

    <!-- Community tax (cedula), computed the way the law says: a base,
         plus a peso for every thousand of declared yearly income, up to a
         ceiling. -->
    <add key="Fee.CommunityTax.Base" value="5" />
    <add key="Fee.CommunityTax.PerThousand" value="1" />
    <add key="Fee.CommunityTax.Cap" value="5000" />

    <!-- ==================================================================
         The rules the barangay asked for
         ================================================================== -->
    <!-- The office window. A request that needs no checking is cleared on
         the spot inside these hours; anything filed outside them waits as
         Pending and is cleared automatically when the window opens again. -->
    <add key="Rule.OfficeWindowStart" value="08:00" />
    <add key="Rule.OfficeWindowEnd" value="16:00" />

    <!-- First-time jobseeker (RA 11261): free once, but only after this
         many months of living in the barangay. -->
    <add key="Rule.JobseekerResidencyMonths" value="6" />

    <!-- How long somebody has lived here before the record stops calling
         them a newcomer, and when it calls them a permanent resident. -->
    <add key="Rule.Residency.NewcomerMonths" value="6" />
    <add key="Rule.Residency.PermanentYears" value="5" />

    <!-- RA 11032: how many working days a simple transaction may take. The
         program warns when a request has been sitting longer than this. -->
    <add key="Rule.RA11032.SimpleWorkingDays" value="3" />

    <!-- ==================================================================
         Security and sign-in
         ================================================================== -->
    <add key="Security.MaxFailedLogins" value="5" />
    <add key="Security.LockoutMinutes" value="15" />
    <!-- The screen locks itself after this many minutes without activity.
         Set it to 0 to switch the idle lock off. -->
    <add key="Security.SessionTimeoutMinutes" value="30" />
    <add key="Security.MinimumPasswordLength" value="8" />
    <!-- A new account must change the password it was given the first time
         it signs in. -->
    <add key="Security.ForcePasswordChangeOnFirstLogin" value="true" />
    <!-- Seal the connection string with the Windows Data Protection API.
         See ConnectionStringProtector in the source for what that does and
         what it does not do. -->
    <add key="Security.ProtectConnectionString" value="false" />

    <!-- There is no "register" screen in this system: the barangay asked
         for it to be removed so that nobody can create their own account
         and read the residents' records. These are the two accounts the
         program creates by itself on a brand-new database, and both are
         told to change their password at the first sign-in.
         Change the passwords below before the barangay starts using this
         on real records. -->
    <add key="Security.InitialAdmin.Username" value="admin" />
    <add key="Security.InitialAdmin.FullName" value="Barangay Administrator" />
    <add key="Security.InitialAdmin.Password" value="Barangay@2026" />
    <add key="Security.InitialClerk.Username" value="clerk" />
    <add key="Security.InitialClerk.FullName" value="Barangay Clerk" />
    <add key="Security.InitialClerk.Password" value="Clerk@2026" />

    <!-- ==================================================================
         Reports
         ================================================================== -->
    <!-- Crystal Reports is used when it is installed on the computer. The
         layout files (.rpt) live in the folder below, next to the program.
         With UseCrystalReports off - or with no Crystal installed - the
         built-in plain-paper reporter draws the same report instead. -->
    <add key="Reports.UseCrystalReports" value="true" />
    <add key="Reports.CrystalFolder" value="Reports\CrystalReports" />
    <add key="Reports.Footer" value="Generated by the Barangay Document System" />

  </appSettings>

  <!-- ====================================================================
       Connection strings

       MySQL is the default because that is what the barangay hall runs.
       The second one is used when Storage is set to SqlServer.
       ==================================================================== -->
  <connectionStrings>
    <add name="BarangayDb"
         connectionString="Server=localhost;Port=3306;Database=barangay_document_system;Uid=root;Pwd=;CharSet=utf8mb4;SslMode=None;AllowUserVariables=True;"
         providerName="MySql.Data.MySqlClient" />

    <add name="BarangaySqlServer"
         connectionString="Server=localhost;Database=BarangayDocumentSystem;Integrated Security=True;MultipleActiveResultSets=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
