<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="3.1.0.0" name="BarangayDocumentSystem.app"/>

  <!-- ============================================================
       HIGH-DPI, v3.1 CORE FIX 2 (the manifest half).

       PerMonitorV2 is declared in three places that agree: this
       dpiAwareness block, the ApplicationHighDpiMode property in the
       .csproj, and a documented section in App.config. With PerMonitorV2
       the window re-scales when it is dragged between monitors of
       different DPI, and MainShell and DocumentPreviewForm handle the
       WM_DPICHANGED message that arrives when that happens.
       ============================================================ -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <!-- The Windows versions the common controls should theme themselves
       for. Windows 10 and 11 are what the barangay office runs. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
