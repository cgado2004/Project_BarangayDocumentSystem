<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BarangayDocumentSystem.RuleChecks</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Same reason as the main project: this harness builds on Linux/macOS
         too, where a net8.0-windows target needs the targeting packs
         allowed. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The v3.1 layout is one project, so the checks reference it directly.
         It is a WinExe, which is fine for a project reference - the rules
         under test (fees, state machine, templates) live in the same
         assembly as the screens, and the checks still touch no user
         interface to run them. -->
    <ProjectReference Include="..\BarangayDocumentSystem.csproj" />
  </ItemGroup>

</Project>
